# ===========================================
# iPark UMAK - Frontend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Credentials will be provided separately via email.
# ===========================================

# Backend API URL
VITE_API_BASE_URL=http://localhost:5000

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=<provided_via_email>

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=<provided_via_email>

