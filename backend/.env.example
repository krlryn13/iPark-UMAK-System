# ===========================================
# iPark UMAK - Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Credentials will be provided separately via email.
# ===========================================

# Server
PORT=5000

# MySQL Database (XAMPP)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ipark_umak

# Authentication & Security
JWT_SECRET=<provided_via_email>
ENCRYPTION_KEY=<provided_via_email>

# Email (Gmail SMTP)
EMAIL_USER=<provided_via_email>
EMAIL_PASS=<provided_via_email>

# PayMongo Payment Gateway
PAYMONGO_SECRET_KEY=<provided_via_email>
PAYMONGO_PUBLIC_KEY=<provided_via_email>

# Google OAuth 2.0
GOOGLE_CLIENT_ID=<provided_via_email>
GOOGLE_CLIENT_SECRET=<provided_via_email>

# ESP32 IoT Diorama Device Auth (optional for web-only runs)
DEVICE_API_KEY=<provided_via_email>


